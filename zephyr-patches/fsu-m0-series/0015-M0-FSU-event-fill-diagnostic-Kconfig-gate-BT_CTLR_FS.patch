From 50334aaec84c5901b88c1a8e2f2e89762b4a2c1d Mon Sep 17 00:00:00 2001
From: teleop-bench <325283884+teleop-bench@users.noreply.github.com>
Date: Tue, 25 Aug 2026 02:04:30 -0500
Subject: [PATCH 15/16] M0 FSU event-fill diagnostic + Kconfig gate
 (BT_CTLR_FSU_EVENTFILL_DIAG)

Per-event packets/event histogram (lll_conn_q2_pe[]) captured in isr_done + a FORCE_MD
arm tally, for the FSU occupancy investigation. Gated behind CONFIG_BT_CTLR_FSU_EVENTFILL_DIAG
(default n): the hot-path writes run only when enabled, because they measurably throttle
high-PDU-rate L2CAP CoC throughput (~170->~130 KB/s at 2M; GATT barely affected). The
lll_conn_q2_pe[] globals stay defined unconditionally (zero cost) so apps reading them still
link when the diag is off. Leave OFF for throughput benchmarking.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../bluetooth/controller/Kconfig.ll_sw_split  | 11 +++++++
 .../controller/ll_sw/nordic/lll/lll_conn.c    | 31 +++++++++++++++++--
 2 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/subsys/bluetooth/controller/Kconfig.ll_sw_split b/subsys/bluetooth/controller/Kconfig.ll_sw_split
index 32deee263db..da691a0648b 100644
--- a/subsys/bluetooth/controller/Kconfig.ll_sw_split
+++ b/subsys/bluetooth/controller/Kconfig.ll_sw_split
@@ -1518,6 +1518,17 @@ config BT_CTLR_FSU_BENCH_FORCE_FEAT
 	  implementation handles as clean procedure termination. Never
 	  enable outside the open<->open bench rig.
 
+config BT_CTLR_FSU_EVENTFILL_DIAG
+	bool "BENCH-ONLY: per-event packets/event histogram in isr_done"
+	help
+	  M0 FSU event-fill diagnostic: records trx_cnt (transactions per connection
+	  event) into lll_conn_q2_pe[] each event, for occupancy analysis. This runs
+	  on the hot radio path (isr_done) and measurably THROTTLES high-PDU-rate
+	  L2CAP CoC throughput (~20%: ~170 -> ~130 KB/s at 2M); GATT is barely
+	  affected. Leave OFF for any throughput benchmark; enable only when you
+	  need the packets/event occupancy stats. The lll_conn_q2_pe[] globals are
+	  always defined (zero cost) so apps that read them still link when this is off.
+
 config BT_CTLR_TIFS_CAPTURE_BENCH
 	bool "BENCH-ONLY: capture RX-PHYEND->TX-READY interval via EVENT_TIMER CC0"
 	help
diff --git a/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_conn.c b/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_conn.c
index d15870eb202..7a165dea776 100644
--- a/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_conn.c
+++ b/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_conn.c
@@ -44,6 +44,12 @@ volatile uint32_t lll_conn_q2_tx[40];    /* ACTUAL TX-completed pkts/chan */
 volatile uint32_t lll_conn_q2_session;   /* controller-owned, ++ per connect setup */
 volatile uint32_t lll_conn_q2_aa;        /* connection AA = shared id (both roles) */
 volatile uint8_t  lll_conn_q2_curchan = 255; /* ACTUAL remapped chan this event */
+/* FSU event-fill diagnostics (2026-08-12): packets/event histogram + FORCE_MD arm count.
+ * lll_conn_q2_pe[i] = # events that closed with trx_cnt==i (index 63 = 63+ overflow). */
+volatile uint16_t lll_conn_q2_pe[64];
+volatile uint16_t lll_conn_q2_pe_max;    /* max trx_cnt seen in any event */
+volatile uint32_t lll_conn_q2_events;    /* connection events closed */
+volatile uint32_t lll_conn_q2_fmd_arm;   /* FORCE_MD arm transitions (0 -> loaded) */
 
 #include "lll_internal.h"
 #include "lll_df_internal.h"
@@ -427,10 +433,24 @@ static uint8_t force_md_cnt;
 
 #define FORCE_MD_CNT_GET() force_md_cnt
 
+/* FSU event-fill: the arm threshold is normally trx_cnt >= ACL_TX_COUNT-1 (a deep pool then
+ * never arms). CONFIG_APP_FORCE_MD_ARM_AT decouples it to a fixed low count so FORCE_MD can
+ * hold the event open and let the deep queue fill it ("forced event-fill" — non-standard). */
+#if defined(CONFIG_APP_FORCE_MD_ARM_AT) && (CONFIG_APP_FORCE_MD_ARM_AT > 0)
+#define FMD_ARM_THRESH (CONFIG_APP_FORCE_MD_ARM_AT)
+#else
+#define FMD_ARM_THRESH ((CONFIG_BT_BUF_ACL_TX_COUNT) - 1)
+#endif
+/* BENCH-ONLY diagnostic tally, gated: keep it OFF for throughput runs (hot path). */
+#if defined(CONFIG_BT_CTLR_FSU_EVENTFILL_DIAG)
+#define FMD_ARM_TALLY() do { if (!force_md_cnt) { lll_conn_q2_fmd_arm++; } } while (false)
+#else
+#define FMD_ARM_TALLY() do { } while (false)
+#endif
 #define FORCE_MD_CNT_SET() \
 		do { \
-			if (force_md_cnt || \
-			    (trx_cnt >= ((CONFIG_BT_BUF_ACL_TX_COUNT) - 1))) { \
+			if (force_md_cnt || (trx_cnt >= FMD_ARM_THRESH)) { \
+				FMD_ARM_TALLY(); \
 				force_md_cnt = BT_CTLR_FORCE_MD_COUNT; \
 			} \
 		} while (false)
@@ -1496,6 +1516,13 @@ static void isr_done(void *param)
 
 	lll_isr_status_reset();
 
+	/* FSU event-fill diagnostic (BENCH-ONLY, gated): record trx_cnt per event. This runs on the
+	 * hot radio path and throttles high-PDU-rate CoC throughput ~20% - keep OFF for throughput. */
+#if defined(CONFIG_BT_CTLR_FSU_EVENTFILL_DIAG)
+	{ uint16_t pe = trx_cnt; lll_conn_q2_pe[(pe < 63U) ? pe : 63U]++; lll_conn_q2_events++;
+	  if (pe > lll_conn_q2_pe_max) { lll_conn_q2_pe_max = pe; } }
+#endif
+
 	e = ull_event_done_extra_get();
 	LL_ASSERT_ERR(e);
 
