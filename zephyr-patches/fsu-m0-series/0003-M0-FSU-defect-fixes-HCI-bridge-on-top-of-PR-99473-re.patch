From 4c305be9512eca481b1b72d37cd9ae8077165fd0 Mon Sep 17 00:00:00 2001
From: teleop-bench <325283884+teleop-bench@users.noreply.github.com>
Date: Fri, 7 Aug 2026 00:14:43 -0500
Subject: [PATCH 03/16] M0 FSU: defect fixes + HCI bridge on top of PR#99473
 reference

Fixes per zephyr-patches/fsu-m0-cheatsheet.md defect list: inverted
change-detection comparisons; tifs_hcto_us follows tifs_rx_us; wrong
CONFIG_BT_PHY_UPDATE guard -> CONFIG_BT_CTLR_PHY; debug printk removed;
range validation (min<=max, <=10ms) in ull_cp_fsu; eff.phys/spacing_type
preserved for the ntf encoder before request-scratch clearing.

New: Kconfig.ll_sw_split selects FRAME_SPACE_UPDATE_SUPPORT +
EXTENDED_FEAT_SET_SUPPORT; BT_CTLR_FSU_BENCH_FORCE_FEAT bench shim
(documented non-conformant: forces feature_fsu known-supported; bit 65
exceeds the 64-bit LLCP mask; UNKNOWN_RSP path handles non-support).
HCI bridge: LE Frame Space Update cmd 0x209D -> bt_ull_cp_fsu (cmd
status); LE Read All Local Supported Features 0x2087 (max_page=1, bit 65
= byte8 bit1) + supported-commands octet 47 bit 2 so the host's
extended-feature read path lights up; FSU Complete meta event 0x35 from
the FSU_RSP ntf (initiator by role per M0 single-initiator convention).

NOT upstreamable as-is (bench shim; no real feature-page exchange - M1).
---
 .../bluetooth/controller/Kconfig.ll_sw_split  |  13 +++
 subsys/bluetooth/controller/hci/hci.c         | 101 ++++++++++++++++++
 subsys/bluetooth/controller/ll_sw/ull_conn.c  |  21 ++--
 subsys/bluetooth/controller/ll_sw/ull_llcp.c  |  10 +-
 .../controller/ll_sw/ull_llcp_features.h      |   9 ++
 .../bluetooth/controller/ll_sw/ull_llcp_pdu.c |   3 +-
 6 files changed, 147 insertions(+), 10 deletions(-)

diff --git a/subsys/bluetooth/controller/Kconfig.ll_sw_split b/subsys/bluetooth/controller/Kconfig.ll_sw_split
index c13e855aa88..add2980032d 100644
--- a/subsys/bluetooth/controller/Kconfig.ll_sw_split
+++ b/subsys/bluetooth/controller/Kconfig.ll_sw_split
@@ -37,6 +37,8 @@ config BT_LLL_VENDOR_NORDIC
 	select BT_CTLR_PHY_CODED_SUPPORT if HAS_HW_NRF_RADIO_BLE_CODED
 	select BT_CTLR_PHY_UPDATE_SUPPORT if BT_CTLR_PHY_2M_SUPPORT || \
 					     BT_CTLR_PHY_CODED_SUPPORT
+	select BT_CTLR_FRAME_SPACE_UPDATE_SUPPORT
+	select BT_CTLR_EXTENDED_FEAT_SET_SUPPORT
 	select BT_CTLR_ADV_EXT_SUPPORT
 	select BT_CTLR_ADV_PERIODIC_SUPPORT
 	select BT_CTLR_SYNC_PERIODIC_SUPPORT
@@ -1504,3 +1506,14 @@ config BT_CTLR_DEBUG_PINS
 	  the code.
 
 endif # BT_LL_SW_SPLIT
+
+config BT_CTLR_FSU_BENCH_FORCE_FEAT
+	bool "BENCH-ONLY: force Frame Space Update feature known-supported"
+	depends on BT_CTLR_FRAME_SPACE_UPDATE
+	help
+	  NON-CONFORMANT bench shim (M0): treats the peer as FSU-capable
+	  without a real Extended Feature Set page exchange (feature bit 65
+	  exceeds the classic 64-bit LLCP feature mask). A non-supporting
+	  peer answers LL_FRAME_SPACE_REQ with LL_UNKNOWN_RSP, which this
+	  implementation handles as clean procedure termination. Never
+	  enable outside the open<->open bench rig.
diff --git a/subsys/bluetooth/controller/hci/hci.c b/subsys/bluetooth/controller/hci/hci.c
index f7f1ad1bdb6..fafbd157263 100644
--- a/subsys/bluetooth/controller/hci/hci.c
+++ b/subsys/bluetooth/controller/hci/hci.c
@@ -857,6 +857,11 @@ static void read_supported_commands(struct net_buf *buf, struct net_buf **evt)
 
 	/* Read Local Version Info, Read Local Supported Features. */
 	rp->commands[14] |= BIT(3) | BIT(5);
+
+#if defined(CONFIG_BT_CTLR_FRAME_SPACE_UPDATE)
+	/* LE Read All Local Supported Features. */
+	rp->commands[47] |= BIT(2);
+#endif /* CONFIG_BT_CTLR_FRAME_SPACE_UPDATE */
 	/* Read BD ADDR. */
 	rp->commands[15] |= BIT(1);
 
@@ -1465,6 +1470,48 @@ static void le_read_local_features(struct net_buf *buf, struct net_buf **evt)
 	sys_put_le64(ll_feat_get(), rp->features);
 }
 
+#if defined(CONFIG_BT_CTLR_FRAME_SPACE_UPDATE)
+/* M0 bench FSU: llcp entry (ull_llcp.c) */
+uint8_t bt_ull_cp_fsu(uint16_t handle, uint16_t fsu_min, uint16_t fsu_max,
+		      uint8_t phys, uint16_t spacing_type);
+struct ll_conn *ll_connected_get(uint16_t handle);
+
+static void le_read_all_local_supported_features(struct net_buf *buf,
+						 struct net_buf **evt)
+{
+	struct bt_hci_rp_le_read_all_local_supported_features *rp;
+
+	rp = hci_cmd_complete(evt, sizeof(*rp));
+
+	rp->status = 0x00;
+	rp->max_page = 1U;
+	(void)memset(&rp->features[0], 0x00, sizeof(rp->features));
+	sys_put_le64(ll_feat_get(), rp->features);
+	/* Frame Space Update: feature bit 65 = byte 8 bit 1 */
+	rp->features[8] |= BIT(1);
+}
+
+static void le_frame_space_update(struct net_buf *buf, struct net_buf **evt)
+{
+	struct bt_hci_cp_le_frame_space_update *cmd = (void *)buf->data;
+	uint16_t frame_space_min;
+	uint16_t frame_space_max;
+	uint16_t spacing_types;
+	uint16_t handle;
+	uint8_t status;
+
+	handle = sys_le16_to_cpu(cmd->handle);
+	frame_space_min = sys_le16_to_cpu(cmd->frame_space_min);
+	frame_space_max = sys_le16_to_cpu(cmd->frame_space_max);
+	spacing_types = sys_le16_to_cpu(cmd->spacing_types);
+
+	status = bt_ull_cp_fsu(handle, frame_space_min, frame_space_max,
+			       cmd->phys, spacing_types);
+
+	*evt = cmd_status(status);
+}
+#endif /* CONFIG_BT_CTLR_FRAME_SPACE_UPDATE */
+
 static void le_set_random_address(struct net_buf *buf, struct net_buf **evt)
 {
 	struct bt_hci_cp_le_set_random_address *cmd = (void *)buf->data;
@@ -4790,6 +4837,19 @@ static int controller_cmd_handle(uint16_t  ocf, struct net_buf *cmd,
 	case BT_OCF(BT_HCI_OP_LE_SET_DATA_LEN):
 		le_set_data_len(cmd, evt);
 		break;
+#endif /* CONFIG_BT_CTLR_DATA_LENGTH */
+
+#if defined(CONFIG_BT_CTLR_FRAME_SPACE_UPDATE)
+	case BT_OCF(BT_HCI_OP_LE_READ_ALL_LOCAL_SUPPORTED_FEATURES):
+		le_read_all_local_supported_features(cmd, evt);
+		break;
+
+	case BT_OCF(BT_HCI_OP_LE_FRAME_SPACE_UPDATE):
+		le_frame_space_update(cmd, evt);
+		break;
+#endif /* CONFIG_BT_CTLR_FRAME_SPACE_UPDATE */
+
+#if defined(CONFIG_BT_CTLR_DATA_LENGTH)
 
 	case BT_OCF(BT_HCI_OP_LE_READ_DEFAULT_DATA_LEN):
 		le_read_default_data_len(cmd, evt);
@@ -9135,6 +9195,41 @@ static void le_data_len_change(struct pdu_data *pdu_data, uint16_t handle,
 }
 #endif /* CONFIG_BT_CTLR_DATA_LENGTH */
 
+#if defined(CONFIG_BT_CTLR_FRAME_SPACE_UPDATE)
+static void le_frame_space_update_complete_encode(struct pdu_data *pdu_data,
+						  uint16_t handle,
+						  struct net_buf *buf)
+{
+	struct bt_hci_evt_le_frame_space_update_complete *sep;
+	struct ll_conn *conn;
+
+	if (!(event_mask & BT_EVT_MASK_LE_META_EVENT) ||
+	    !(le_event_mask & BT_EVT_MASK_LE_FRAME_SPACE_UPDATE_COMPLETE)) {
+		return;
+	}
+
+	sep = meta_evt(buf, BT_HCI_EVT_LE_FRAME_SPACE_UPDATE_COMPLETE,
+		       sizeof(*sep));
+
+	sep->status = 0x00;
+	sep->handle = sys_cpu_to_le16(handle);
+	/* M0 single-initiator convention: the central is the only
+	 * initiator, so a completion on the central is host-initiated and
+	 * one on the peripheral is peer-initiated.
+	 */
+	conn = ll_connected_get(handle);
+	if (conn && conn->lll.role == BT_HCI_ROLE_CENTRAL) {
+		sep->initiator = BT_HCI_LE_FRAME_SPACE_UPDATE_INITIATOR_LOCAL_HOST;
+	} else {
+		sep->initiator = BT_HCI_LE_FRAME_SPACE_UPDATE_INITIATOR_PEER;
+	}
+	/* pdu fields are already little-endian */
+	sep->frame_space = pdu_data->llctrl.fsu_rsp.fsu;
+	sep->phys = pdu_data->llctrl.fsu_rsp.phys;
+	sep->spacing_types = pdu_data->llctrl.fsu_rsp.spacing_type;
+}
+#endif /* CONFIG_BT_CTLR_FRAME_SPACE_UPDATE */
+
 #if defined(CONFIG_BT_REMOTE_VERSION)
 static void remote_version_info_encode(struct pdu_data *pdu_data,
 				       uint16_t handle, struct net_buf *buf)
@@ -9205,6 +9300,12 @@ static void encode_data_ctrl(struct node_rx_pdu *node_rx,
 		break;
 #endif /* CONFIG_BT_CTLR_DATA_LENGTH */
 
+#if defined(CONFIG_BT_CTLR_FRAME_SPACE_UPDATE)
+	case PDU_DATA_LLCTRL_TYPE_FRAME_SPACE_RSP:
+		le_frame_space_update_complete_encode(pdu_data, handle, buf);
+		break;
+#endif /* CONFIG_BT_CTLR_FRAME_SPACE_UPDATE */
+
 #if defined(CONFIG_BT_CTLR_DF_CONN_CTE_REQ)
 	case PDU_DATA_LLCTRL_TYPE_CTE_RSP:
 		le_df_cte_req_failed(BT_HCI_CTE_REQ_STATUS_RSP_WITHOUT_CTE, handle, buf);
diff --git a/subsys/bluetooth/controller/ll_sw/ull_conn.c b/subsys/bluetooth/controller/ll_sw/ull_conn.c
index f464eca245d..f8a3c6aee9f 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_conn.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_conn.c
@@ -2853,13 +2853,13 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 	uint8_t phy_tx;
 	uint8_t phy_rx;
 
-#if defined(CONFIG_BT_PHY_UPDATE)
+#if defined(CONFIG_BT_CTLR_PHY)
 	phy_tx = conn->lll.phy_tx;
 	phy_rx = conn->lll.phy_rx;
 #else
 	phy_tx = PHY_1M;
 	phy_rx = PHY_1M;
-#endif /* CONFIG_BT_PHY_UPDATE */
+#endif /* CONFIG_BT_CTLR_PHY */
 
 	fsu_changed = ull_fsu_update_eff_from_local(conn);
 
@@ -2869,7 +2869,7 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 
 	if ((conn->lll.fsu.local.spacing_type & T_IFS_CIS) == T_IFS_CIS) {
 
-		if (conn->lll.tifs_cis_us == conn->lll.fsu.eff.fsu_min) {
+		if (conn->lll.tifs_cis_us != conn->lll.fsu.eff.fsu_min) {
 			fsu_changed = 1;
 		}
 		conn->lll.tifs_cis_us = conn->lll.fsu.eff.fsu_min;
@@ -2878,7 +2878,7 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 	if ((conn->lll.fsu.local.spacing_type & T_IFS_ACL_CP) == T_IFS_ACL_CP) {
 		if (conn->lll.role == BT_HCI_ROLE_PERIPHERAL) {
 			if (conn->lll.fsu.local.phys & phy_tx) {
-				if (conn->lll.tifs_tx_us ==
+				if (conn->lll.tifs_tx_us !=
 				    conn->lll.fsu.eff.fsu_min) {
 					fsu_changed = 1;
 				}
@@ -2886,11 +2886,12 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 			}
 		} else {
 			if (conn->lll.fsu.local.phys & phy_rx) {
-				if (conn->lll.tifs_rx_us ==
+				if (conn->lll.tifs_rx_us !=
 				    conn->lll.fsu.eff.fsu_min) {
 					fsu_changed = 1;
 				}
 				conn->lll.tifs_rx_us = conn->lll.fsu.eff.fsu_min;
+				conn->lll.tifs_hcto_us = conn->lll.fsu.eff.fsu_min;
 			}
 		}
 	}
@@ -2898,15 +2899,16 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 	if ((conn->lll.fsu.local.spacing_type & T_IFS_ACL_PC) == T_IFS_ACL_PC) {
 		if (conn->lll.role == BT_HCI_ROLE_PERIPHERAL) {
 			if (conn->lll.fsu.local.phys & phy_rx) {
-				if (conn->lll.tifs_rx_us ==
+				if (conn->lll.tifs_rx_us !=
 				    conn->lll.fsu.eff.fsu_min) {
 					fsu_changed = 1;
 				}
 				conn->lll.tifs_rx_us = conn->lll.fsu.eff.fsu_min;
+				conn->lll.tifs_hcto_us = conn->lll.fsu.eff.fsu_min;
 			}
 		} else {
 			if (conn->lll.fsu.local.phys & phy_tx) {
-				if (conn->lll.tifs_tx_us ==
+				if (conn->lll.tifs_tx_us !=
 				    conn->lll.fsu.eff.fsu_min) {
 					fsu_changed = 1;
 				}
@@ -2915,6 +2917,11 @@ uint8_t ull_fsu_update_eff(struct ll_conn *conn)
 		}
 	}
 	if (fsu_changed == 1) {
+		/* Preserve what changed for the notification encoder before
+		 * clearing the request-scratch fields.
+		 */
+		conn->lll.fsu.eff.phys = conn->lll.fsu.local.phys;
+		conn->lll.fsu.eff.spacing_type = conn->lll.fsu.local.spacing_type;
 		conn->lll.fsu.local.phys = 0;
 		conn->lll.fsu.local.spacing_type = 0;
 	}
diff --git a/subsys/bluetooth/controller/ll_sw/ull_llcp.c b/subsys/bluetooth/controller/ll_sw/ull_llcp.c
index 5b5150aeb07..21a3f7d779f 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_llcp.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_llcp.c
@@ -948,8 +948,16 @@ uint8_t ull_cp_fsu(struct ll_conn *conn, uint16_t fsu_min, uint16_t fsu_max,
 {
 	struct proc_ctx *ctx;
 
+	/* Range validation: min<=max, and an upper bound of 10 ms per the
+	 * public feature descriptions (exact spec bound to be re-verified
+	 * when the spec text is directly quotable - cheat-sheet item).
+	 */
+	if ((fsu_min > fsu_max) || (fsu_max > 10000U)) {
+		return BT_HCI_ERR_INVALID_PARAM;
+	}
+
 	if (!feature_fsu(conn)) {
-		return BT_HCI_ERR_SUCCESS;
+		return BT_HCI_ERR_UNSUPP_REMOTE_FEATURE;
 	}
 
 	ctx = llcp_create_local_procedure(PROC_FRAME_SPACE);
diff --git a/subsys/bluetooth/controller/ll_sw/ull_llcp_features.h b/subsys/bluetooth/controller/ll_sw/ull_llcp_features.h
index d3dd6a0c835..62ffdf5fc83 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_llcp_features.h
+++ b/subsys/bluetooth/controller/ll_sw/ull_llcp_features.h
@@ -70,6 +70,15 @@ static inline bool feature_dle(struct ll_conn *conn)
 
 static inline bool feature_fsu(struct ll_conn *conn)
 {
+	/* Feature bit 65 exceeds the 64-bit LLCP feature mask; the real
+	 * Extended Feature Set exchange is M1 work. Under the documented
+	 * M0 bench shim the feature is forced known-supported (peer
+	 * without support answers UNKNOWN_RSP -> clean termination).
+	 */
+	if (IS_ENABLED(CONFIG_BT_CTLR_FSU_BENCH_FORCE_FEAT)) {
+		return true;
+	}
+
 	return (conn->llcp.fex.features_used & LL_FEAT_BIT_FRAME_SPACE) != 0;
 }
 
diff --git a/subsys/bluetooth/controller/ll_sw/ull_llcp_pdu.c b/subsys/bluetooth/controller/ll_sw/ull_llcp_pdu.c
index 31793e1adc1..f7444d89139 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_llcp_pdu.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_llcp_pdu.c
@@ -757,7 +757,6 @@ void llcp_pdu_encode_fsu_rsp(struct ll_conn *conn, struct pdu_data *pdu)
 	p->fsu = sys_cpu_to_le16(conn->lll.fsu.local.fsu_min);
 	p->phys = conn->lll.fsu.local.phys;
 	p->spacing_type = sys_cpu_to_le16(conn->lll.fsu.local.spacing_type);
-	printk("%s: fsu %u\n", __func__, p->fsu);
 }
 
 void llcp_ntf_encode_fsu_change(struct ll_conn *conn, struct pdu_data *pdu)
@@ -770,7 +769,7 @@ void llcp_ntf_encode_fsu_change(struct ll_conn *conn, struct pdu_data *pdu)
 	p = &pdu->llctrl.fsu_rsp;
 
 	p->fsu = sys_cpu_to_le16(conn->lll.fsu.eff.fsu_min);
-	p->phys = conn->lll.fsu.local.phys;
+	p->phys = conn->lll.fsu.eff.phys;
 	p->spacing_type = sys_cpu_to_le16(conn->lll.fsu.eff.spacing_type);
 }
 
