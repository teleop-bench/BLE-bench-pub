+		if (phy_changed) {
+			pu_update_eff_tifs(conn, ctx);
+		}
+
 		/* if PHY settings changed we should generate NTF */
 		ctx->data.pu.ntf_pu = phy_changed;
 		rp_pu_complete(conn, ctx, evt, param);
