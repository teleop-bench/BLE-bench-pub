# CoC central FSU target: request [MIN..MAX] frame space after the channel is up.
# In-band control uses MIN=MAX=150 (FSU procedure runs, grants no reduction) so the
# ONLY variable between arms is the granted spacing (52 vs 150 us).
config APP_FSU_MIN_US
	int "FSU requested minimum frame space (us)"
	default 0
	range 0 10000
config APP_FSU_MAX_US
	int "FSU requested maximum frame space (us; 0 = no FSU request)"
	default 0
	range 0 10000
config APP_AUTO_FSU
	bool "Auto-request FSU once the CoC channel is up"
	depends on BT_FRAME_SPACE_UPDATE
	default n
config APP_CONN_INT_UNITS
	int "Pinned connection interval (1.25 ms units): 6=7.5ms 12=15ms 20=25ms"
	default 6
	range 6 3200

config APP_DUPLEX_SDU_SIZE
	int "Downlink SDU size in bytes (default 480 = two LL packets at DLE 251)"
	default 480
	range 23 512
	help
	  Size of the SDUs the central's downlink sender blasts. The sink's uplink
	  uses 244-byte SDUs (one LL packet each); other values are for diagnosing
	  the duplex split.

config APP_TX_POOL_COUNT
	int "Downlink SDU pool depth (default 16 = the shallow-pool duplex fix)"
	default 16
	range 1 128
	help
	  Number of SDU buffers the central's downlink sender may have in flight.
	  16 is the documented duplex fix (keeps the queue shallow so the peer's
	  uplink is not starved); other values are for diagnosing the duplex split.

config APP_CREDIT_TRACE
	bool "Print a 1 s CTRACE line of TX credit/queue state (diagnostic)"
	help
	  Samples the CoC channel's TX credits, its L2CAP queue and the controller's
	  free ACL buffers every APP_CREDIT_TRACE_US and prints their distribution.
	  Off by default (images unchanged).

config APP_CREDIT_TRACE_US
	int "CTRACE sample period (us)"
	default 500
	depends on APP_CREDIT_TRACE

source "Kconfig.zephyr"
