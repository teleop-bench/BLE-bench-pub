/* Safety-watchdog bench GPIOs (§14.9).
 *
 * Pins VERIFIED against zephyr/boards/nordic/nrf54l15dk on 2026-08-05:
 * port-1 claims are P1.00/01 XL1/XL2 (32k crystal), P1.02/03 NFC,
 * P1.04-07 uart20 console, P1.08 button2, P1.09 button1, P1.10 led1,
 * P1.13 button0, P1.14 led3. P1.15/P1.16 are NOT routed to the DK
 * headers (PORT P1 header ends at 13/14) — third signal on P2.06
 * (free: port-2 claims are P2.01/02/04/05 SPI flash, P2.07/09 LEDs).
 * The §14.9 hardware inputs (final pin, STOP polarity, drive type, boot
 * state, re-arm form) supersede these when a real actuator circuit exists.
 *
 * STOP is GPIO_ACTIVE_LOW: logical "asserted" = line LOW. Fit the EXTERNAL
 * pull-down so the line reads LOW (= STOP) while the MCU is held in reset,
 * unpowered, or the pin is high-impedance — RUN must require active drive.
 */
&wdt31 {
	status = "okay";   /* §14.9 rev-4: hardware watchdog carries the deadline */
};

/ {
	zephyr,user {
		stop-gpios   = <&gpio1 11 GPIO_ACTIVE_LOW>;   /* STOP output (latched)   */
		wdtexp-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;  /* LA: toggles at expiry-callback entry */
		hbrx-gpios   = <&gpio2 6 GPIO_ACTIVE_HIGH>;   /* LA: toggles per valid HB */
		hbrx2-gpios  = <&gpio2 10 GPIO_ACTIVE_HIGH>;  /* HBRX mirror for the chip-EXTERNAL
		                     watchdog (nRF52-DK feed input): its own copy of the
		                     valid-HB toggle so no header hole needs two wires */
		mon-gpios    = <&gpio2 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		                    /* cross-board fail-safe monitor (bench stand-in for the
		                     * discrete pull-down): input + internal ~13k pull-down,
		                     * jumpered to the CENTRAL's ALIVE pin for the
		                     * power-loss->ALIVE-falls check; this board survives
		                     * that test, so its pull is external to the DUT. */
	};
};
