# BLE & NimBLE core
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# L2CAP CoC — block count for NimBLE internal usage + L2CAP buffers
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=536
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=40

# Roles: peripheral only (saves flash)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# NimBLE stack size
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=6144

# Larger partition for zenoh-pico
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Increase main task stack for zenoh session
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# VFS eventfd for BLE L2CAP select() integration
CONFIG_VFS_SUPPORT_SELECT=y
